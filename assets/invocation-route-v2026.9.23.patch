+class RouteLockedCallError(RuntimeError):
+    """A route-locked call failed. ``code`` is short and provider-message free."""
+
+    def __init__(self, code: str) -> None:
+        super().__init__(f"route-locked call failed: {code}")
+        self.code = code
+
+
+def classify_route_locked_error(exc: Exception) -> str:
+    """Map a provider exception to a stable, non-leaking code.
+
+    Deliberately coarse. The caller journals this string into the plugin's own
+    records, and a provider message can carry a base URL, a key fragment or an
+    echo of the request body -- none of which belongs in a durable log.
+    """
+    if _is_auth_error(exc):
+        return "auth_error"
+    if _is_payment_error(exc):
+        return "payment_error"
+    if _is_rate_limit_error(exc):
+        return "rate_limited"
+    if _is_model_incompatible_error(exc):
+        return "model_incompatible"
+    if _is_invalid_aux_response_error(exc):
+        return "invalid_response"
+    if _is_connection_error(exc) or _is_transient_transport_error(exc):
+        return "transport_error"
+    return "call_failed"
+
+
+# Route-locked calls support the ordinary OpenAI-shaped chat path. Anything else
+# fails closed with ``unsupported_api_mode`` rather than being coerced: the point
+# of a locked route is that the request goes exactly where it was captured from,
+# and a silent transport substitution is the failure this path is built to avoid.
+_ROUTE_LOCKED_API_MODES = frozenset({"", "chat_completions", "openai", "openai_chat", "anthropic_messages", "codex_responses"})
+
+
+def _route_locked_request(
+    *, provider: str, model: str, base_url: str, api_key: Any, api_mode: str, client: Any,
+    messages: list, temperature: Optional[float], max_tokens: Optional[int],
+    timeout: Optional[float], extra_body: Optional[dict],
+) -> tuple[Any, Dict[str, Any]]:
+    """Validate one exact route and build its transport plus request kwargs."""
+    mode = (api_mode or "").strip().lower()
+    if client is None:
+        raise RouteLockedCallError("incomplete_route")
+    if not provider or not model or not base_url:
+        raise RouteLockedCallError("incomplete_route")
+    if mode not in _ROUTE_LOCKED_API_MODES:
+        raise RouteLockedCallError("unsupported_api_mode")
+    if not messages:
+        raise RouteLockedCallError("empty_request")
+    request_client = client
+    if mode == "anthropic_messages":
+        is_oauth = isinstance(api_key, str) and api_key.startswith("sk-ant-oat")
+        request_client = AnthropicAuxiliaryClient(
+            client, model, api_key, base_url, is_oauth=is_oauth)
+    elif mode == "codex_responses":
+        request_client = CodexAuxiliaryClient(client, model)
+    kwargs = _build_call_kwargs(
+        provider, model, messages, temperature=temperature, max_tokens=max_tokens,
+        tools=None, timeout=timeout, extra_body=dict(extra_body or {}),
+        reasoning_config=None, base_url=base_url, task=None,
+    )
+    return request_client, kwargs
+
+
+def _route_locked_create(request_client: Any) -> Callable[[Dict[str, Any]], Any]:
+    """The single-request transport for a locked route.
+
+    ``_relay_sync_completion`` defaults to ``_create_with_progress``, which is right
+    for auxiliary tasks and wrong here. That wrapper sends ``stream=True`` whenever a
+    progress hook is installed and falls back to a plain call if the provider rejects
+    the streamed one, and it retries a credit-limited 402 once with a clamped output
+    cap. Both are a second request on a path whose whole contract is exactly one, so
+    this path brings its own ``create`` instead of inheriting the default.
+
+    Consequence, accepted deliberately: a locked call does not tick the auxiliary
+    progress hook. It is one short blocking request carrying its own timeout, and
+    ticking a hook installed for a different task would mask that task's silence.
+    """
+    return lambda request: request_client.chat.completions.create(**request)
+
+
+def call_llm_route_locked(
+    *, provider: str, model: str, base_url: str, api_key: Any, api_mode: str, client: Any,
+    messages: list, temperature: Optional[float] = None, max_tokens: Optional[int] = None,
+    timeout: Optional[float] = None, extra_body: Optional[dict] = None,
+) -> Any:
+    """One request on exactly the given route. No retry, no fallback, no reroute.
+
+    Separate from ``call_llm`` on purpose. That function's value is its recovery
+    ladder -- same-provider retries, parameter stripping, provider fallback -- and
+    every rung of it can move a call somewhere the caller did not choose. A plugin
+    reasoning about the user's private conversation needs the opposite guarantee:
+    this exact provider, model and client, once, or an honest failure. Threading a
+    "do not recover" flag through the ladder would leave that guarantee one
+    refactor away from silently lapsing.
+
+    Native Anthropic and Codex modes wrap that same captured client with the
+    host's existing protocol adapter; credentials and transport are not rebuilt.
+    """
+    request_client, kwargs = _route_locked_request(
+        provider=provider, model=model, base_url=base_url, api_key=api_key,
+        api_mode=api_mode, client=client,
+        messages=messages, temperature=temperature, max_tokens=max_tokens, timeout=timeout,
+        extra_body=extra_body)
+    _set_relay_auxiliary_route(provider, model, api_mode)
+    try:
+        return _validate_llm_response(
+            _relay_sync_completion(
+                request_client, kwargs, provider=provider, api_mode=api_mode,
+                create=_route_locked_create(request_client)), None)
+    except RouteLockedCallError:
+        raise
+    except Exception as exc:
+        raise RouteLockedCallError(classify_route_locked_error(exc)) from exc
+
+
+async def async_call_llm_route_locked(
+    *, provider: str, model: str, base_url: str, api_key: Any, api_mode: str, client: Any,
+    messages: list, temperature: Optional[float] = None, max_tokens: Optional[int] = None,
+    timeout: Optional[float] = None, extra_body: Optional[dict] = None,
+) -> Any:
+    """Async sibling of :func:`call_llm_route_locked`, with the same guarantees."""
+    import asyncio
+    request_client, kwargs = _route_locked_request(
+        provider=provider, model=model, base_url=base_url, api_key=api_key,
+        api_mode=api_mode, client=client,
+        messages=messages, temperature=temperature, max_tokens=max_tokens, timeout=timeout,
+        extra_body=extra_body)
+    _set_relay_auxiliary_route(provider, model, api_mode)
+    try:
+        return _validate_llm_response(
+            await asyncio.to_thread(
+                _relay_sync_completion, request_client, kwargs,
+                provider=provider, api_mode=api_mode,
+                create=_route_locked_create(request_client)), None)
+    except RouteLockedCallError:
+        raise
+    except Exception as exc:
+        raise RouteLockedCallError(classify_route_locked_error(exc)) from exc
+
