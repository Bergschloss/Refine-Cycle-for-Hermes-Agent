+                return _tuple_agent(cache.get(session_key))
+        except Exception:
+            logger.debug("Plugin command agent lookup failed", exc_info=True)
+            return None
+
     def _hm_bundle_slash_rewrite(
         self, event: "MessageEvent", source: SessionSource, _quick_key: str, command: str
     ) -> bool:
