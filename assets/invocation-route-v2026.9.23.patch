+@dataclass(frozen=True)
+class PluginInvocationRoute:
+    """Immutable provider route captured from one active host invocation.
+
+    A plugin that reasons about the user's private conversation must reach the
+    model the user's own turn is using -- same provider, same model, same client,
+    the host's credentials -- and must never silently land somewhere else. This
+    carries that binding as a value so it cannot drift after capture: a mid-turn
+    ``/model`` switch or a fallback rotation cannot mutate a route already handed
+    to a plugin.
+    """
+
+    provider: str
+    model: str
+    base_url: str
+    api_key: Any
+    api_mode: str
+    client: Any = field(default=None, compare=False, repr=False)
+
+    @classmethod
+    def from_agent(cls, agent: Any) -> "PluginInvocationRoute":
+        """Capture the route of a live agent, including its exact client object.
+
+        The client matters as much as the provider string: rebuilding one from
+        provider/base_url/api_key would produce a different transport with its own
+        auth and pooling, which is precisely the "somewhere else" this class
+        exists to prevent.
+        """
+        if agent is None:
+            raise RuntimeError("plugin invocation route requires a live agent")
+        api_mode = str(getattr(agent, "api_mode", "") or "").strip()
+        client = (
+            getattr(agent, "_anthropic_client", None)
+            if api_mode == "anthropic_messages"
+            else getattr(agent, "client", None)
+        )
+        return cls(
+            provider=str(getattr(agent, "provider", "") or "").strip(),
+            model=str(getattr(agent, "model", "") or "").strip(),
+            base_url=str(getattr(agent, "base_url", "") or "").strip(),
+            api_key=getattr(agent, "api_key", ""),
+            api_mode=api_mode,
+            client=client,
+        ).validated()
+
+    def validated(self) -> "PluginInvocationRoute":
+        """Refuse a route that cannot name where it goes.
+
+        Fail closed: an under-specified route would fall back to ambient config
+        and send private evidence to whatever the config happens to say.
+        """
+        if not self.provider or self.provider == "auto":
+            raise RuntimeError("plugin invocation route requires an explicit provider")
+        if not self.model:
+            raise RuntimeError("plugin invocation route requires an explicit model")
+        if not self.base_url:
+            raise RuntimeError("plugin invocation route requires an explicit base URL")
+        if not self.api_mode:
+            raise RuntimeError("plugin invocation route requires an explicit API mode")
+        return self
+
+
