+def _route_locked_request(
+    *, provider: str, model: str, base_url: str, api_mode: str, client: Any,
+    messages: list, temperature: Optional[float], max_tokens: Optional[int],
+    timeout: Optional[float], extra_body: Optional[dict],
+) -> Dict[str, Any]:
+    """Validate a locked route and build its request kwargs.
+
+    Raises :class:`RouteLockedCallError` -- never falls back to ambient config.
+    """
+    if client is None:
+        raise RouteLockedCallError("incomplete_route")
+    if not provider or not model or not base_url:
+        raise RouteLockedCallError("incomplete_route")
+    if (api_mode or "").strip().lower() not in _ROUTE_LOCKED_API_MODES:
+        raise RouteLockedCallError("unsupported_api_mode")
+    if not messages:
+        raise RouteLockedCallError("empty_request")
