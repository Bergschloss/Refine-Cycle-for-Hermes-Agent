+
+
+@contextmanager
+def plugin_invocation_scope(route: Any = None):
+    """Open a reset-safe invocation scope, failing closed until a route is assigned."""
+    binding = _PluginInvocationBinding(
+        route=route, error_code=None if route is not None else "incomplete_route")
+    token = _plugin_invocation_binding.set(binding)
+    try:
+        yield
+    finally:
+        # reset(token), not set(None): a nested scope must restore its parent's
+        # binding rather than clear it, or the outer turn loses its route.
+        _plugin_invocation_binding.reset(token)
+
+
+def set_plugin_invocation_route(route: Any) -> bool:
+    """Assign a settled route inside an active scope. False when none is open."""
+    if _plugin_invocation_binding.get() is None:
+        return False
+    _plugin_invocation_binding.set(_PluginInvocationBinding(route=route, error_code=None))
+    return True
+
+
+def set_plugin_invocation_agent(agent: Any) -> bool:
+    """Bind the live agent inside an active scope. False when none is open.
+
+    The agent rather than a snapshot: the route is then captured at the moment the
+    plugin actually asks, so a provider rotation between turn setup and the
+    plugin's call is reflected instead of being served stale.
+    """
+    if _plugin_invocation_binding.get() is None:
+        return False
+    _plugin_invocation_binding.set(_PluginInvocationBinding(agent=agent, error_code=None))
+    return True
+
+
+@contextmanager
+def plugin_invocation_scope_for_agent(agent: Any):
+    """Bind a direct command to its live agent, or expose a stable failure.
+
+    Used by the CLI/gateway/TUI slash-command paths, which run outside the turn
+    loop and therefore have no scope of their own. A capture failure is not raised
+    at the caller: the scope opens fail-closed instead, so the plugin's own status
+    surface reports an unavailable route rather than the command dying.
+    """
+    route = None
