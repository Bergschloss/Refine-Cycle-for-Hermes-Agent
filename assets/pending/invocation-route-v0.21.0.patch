+        provider=provider, model=model, base_url=base_url, api_mode=api_mode, client=client,
+        messages=messages, temperature=temperature, max_tokens=max_tokens, timeout=timeout,
+        extra_body=extra_body)
+    _set_relay_auxiliary_route(provider, model, api_mode)
+    try:
+        return _validate_llm_response(
+            _relay_sync_completion(client, kwargs, provider=provider, api_mode=api_mode), None)
+    except RouteLockedCallError:
+        raise
+    except Exception as exc:
+        raise RouteLockedCallError(classify_route_locked_error(exc)) from exc
