+# fails closed with ``unsupported_api_mode`` rather than being coerced: the point
+# of a locked route is that the request goes exactly where it was captured from,
+# and a silent transport substitution is the failure this path is built to avoid.
+_ROUTE_LOCKED_API_MODES = frozenset({"", "chat_completions", "openai", "openai_chat"})
