index 000000000..d85d59c7a
--- /dev/null
+++ b/tests/agent/test_plugin_invocation_route.py
@@ -0,0 +1,404 @@
+"""Regression coverage for invocation-bound plugin LLM routing.
+
+A plugin that reasons about the user's private conversation must reach the model
+that conversation is already using -- same provider, same model, same client, the
+host's own credentials -- exactly once, and must fail closed rather than land
+anywhere else. These tests pin that contract, because every way of getting it
+wrong is silent: a call that quietly falls back to the configured auxiliary route
+still returns a plausible answer, and nothing in the result says it went to a
+different provider than the caller pinned.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextvars
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from agent.auxiliary_client import RouteLockedCallError, classify_route_locked_error
+from agent.plugin_llm import (
+    BoundPluginLlm,
+    PluginInvocationRoute,
+    PluginLlm,
+    PluginLlmInvocationError,
+    PluginLlmTextInput,
+    PluginLlmTrustError,
+)
+from hermes_cli import plugins as hp
+
+
+def _response(text: str = "ok"):
+    return SimpleNamespace(
+        choices=[SimpleNamespace(message=SimpleNamespace(content=text))],
+        usage=SimpleNamespace(prompt_tokens=1, completion_tokens=1, total_tokens=2),
+        model="locked-model",
+    )
+
+
+class _RecordingClient:
+    """Counts physical requests so "exactly once" is an assertion, not a hope."""
+
+    def __init__(self, *, raises: BaseException | None = None):
+        self.calls: list[dict] = []
+        self._raises = raises
+        outer = self
+
+        class _Completions:
+            def create(self, **kwargs):
+                outer.calls.append(kwargs)
+                if outer._raises is not None:
+                    raise outer._raises
+                return _response()
+
+        self.chat = SimpleNamespace(completions=_Completions())
+        self.base_url = "https://locked.example/v1"
+
+
+def _route(*, client=None, model: str = "locked-model", api_mode: str = "chat_completions"):
+    return PluginInvocationRoute(
+        provider="custom", model=model, base_url="https://locked.example/v1",
+        api_key="test-key", api_mode=api_mode, client=client or _RecordingClient(),
+    )
+
+
+def _agent(**overrides):
+    base = dict(
+        provider="custom", model="locked-model", base_url="https://locked.example/v1",
+        api_key="test-key", api_mode="chat_completions", client=_RecordingClient(),
+    )
+    base.update(overrides)
+    return SimpleNamespace(**base)
+
+
+# ── The route value itself ────────────────────────────────────────────────────
+
+@pytest.mark.parametrize("missing", ["provider", "model", "base_url", "api_mode"])
+def test_a_route_that_cannot_name_where_it_goes_is_refused(missing):
+    """Fail closed. An under-specified route would resolve from ambient config."""
+    with pytest.raises(RuntimeError):
+        _route().__class__(**{**_route().__dict__, missing: ""}).validated()
+
+
+def test_a_provider_of_auto_is_not_an_explicit_route():
+    with pytest.raises(RuntimeError):
+        _route().__class__(**{**_route().__dict__, "provider": "auto"}).validated()
+
+
+def test_from_agent_captures_the_agents_own_client_object():
+    """Not a rebuilt client: a new transport would carry different auth/pooling."""
+    agent = _agent()
+    route = PluginInvocationRoute.from_agent(agent)
+    assert route.client is agent.client
+    assert (route.provider, route.model) == ("custom", "locked-model")
+
+
+def test_from_agent_picks_the_anthropic_client_for_that_api_mode():
+    anthropic = _RecordingClient()
+    agent = _agent(api_mode="anthropic_messages", _anthropic_client=anthropic)
+    assert PluginInvocationRoute.from_agent(agent).client is anthropic
+
+
+def test_a_route_is_immutable_after_capture():
+    """A mid-turn /model switch must not mutate a route already handed out."""
+    route = _route()
+    with pytest.raises(Exception):
+        route.model = "something-else"  # type: ignore[misc]
+
+
+# ── Scope mechanics ───────────────────────────────────────────────────────────
+
+def test_outside_any_scope_the_facade_is_not_bound():
+    assert PluginLlm(plugin_id="p").invocation_bound is False
+
+
+def test_an_empty_scope_is_fail_closed_not_unbound():
+    """The subtle one: opening a scope must not hand back the ambient facade.
+
+    If it did, a plugin that asked for the active invocation route would silently
+    get the configured auxiliary route instead -- the exact substitution this
+    mechanism exists to prevent -- and would have no way to tell.
+    """
+    llm = PluginLlm(plugin_id="p")
+    with hp.plugin_invocation_scope():
+        bound = llm.bind_invocation_error("incomplete_route")
+        assert bound.invocation_bound is True
+        with pytest.raises(PluginLlmInvocationError) as excinfo:
+            bound.complete(messages=[{"role": "user", "content": "hi"}])
+    assert excinfo.value.code == "incomplete_route"
+
+
+def test_a_nested_scope_restores_its_parents_binding():
+    outer = _route(model="outer-model")
+    with hp.plugin_invocation_scope(outer):
+        assert hp._plugin_invocation_binding.get().route.model == "outer-model"
+        with hp.plugin_invocation_scope(_route(model="inner-model")):
+            assert hp._plugin_invocation_binding.get().route.model == "inner-model"
+        assert hp._plugin_invocation_binding.get().route.model == "outer-model"
+    assert hp._plugin_invocation_binding.get() is None
+
+
+def test_assignment_outside_a_scope_reports_failure_rather_than_leaking():
+    """A route set with no scope open would outlive the invocation."""
+    assert hp.set_plugin_invocation_route(_route()) is False
+    assert hp.set_plugin_invocation_agent(_agent()) is False
+    assert hp._plugin_invocation_binding.get() is None
+
+
+def test_an_agent_bound_late_makes_an_open_scope_usable():
+    with hp.plugin_invocation_scope():
+        assert hp.set_plugin_invocation_agent(_agent()) is True
+        assert hp._plugin_invocation_binding.get().error_code is None
+
+
+def test_scope_for_agent_falls_closed_when_the_agent_cannot_describe_a_route():
+    """A broken agent is a refusal, not a licence to use ambient config."""
+    with hp.plugin_invocation_scope_for_agent(SimpleNamespace()):
+        binding = hp._plugin_invocation_binding.get()
+    assert binding.route is None
+    assert binding.error_code == "incomplete_route"
+
+
+def test_scope_for_agent_settles_the_runtime_before_capturing():
+    """Capture must happen after primary restoration, or it pins a fallback route."""
+    calls: list[str] = []
+
+    agent = _agent()
+    agent._restore_primary_runtime = lambda: calls.append("restored")
+    with hp.plugin_invocation_scope_for_agent(agent):
+        assert hp._plugin_invocation_binding.get().route is not None
+    assert calls == ["restored"]
+
+
+def test_the_binding_crosses_the_async_command_helper_thread():
+    """resolve_plugin_command_result runs async handlers on a bare thread.
+
+    A bare thread starts with an empty Context, so without copy_context the same
+    command would work synchronously and lose its route asynchronously.
+    """
+    seen: dict = {}
+
+    async def _handler():
+        binding = hp._plugin_invocation_binding.get()
+        seen["model"] = None if binding is None or binding.route is None else binding.route.model
+        return "done"
+
+    async def _outer():
+        # A running loop is what forces the helper-thread path.
+        return hp.resolve_plugin_command_result(_handler())
+
+    with hp.plugin_invocation_scope(_route(model="threaded-model")):
+        assert asyncio.run(_outer()) == "done"
+    assert seen["model"] == "threaded-model"
+
+
+# ── ctx.llm binding ───────────────────────────────────────────────────────────
+
+def _context():
+    manifest = SimpleNamespace(name="refine", key="refine")
+    ctx = hp.PluginContext.__new__(hp.PluginContext)
+    ctx.manifest = manifest
+    ctx._manager = SimpleNamespace(_plugins={})
+    ctx._llm = None
+    return ctx
+
+
+def test_ctx_llm_is_plain_outside_a_scope_and_bound_inside_one():
+    ctx = _context()
+    assert ctx.llm.invocation_bound is False
+    with hp.plugin_invocation_scope(_route()):
+        bound = ctx.llm
+        assert isinstance(bound, BoundPluginLlm)
+        assert bound.invocation_bound is True
+    assert ctx.llm.invocation_bound is False
+
+
+def test_ctx_llm_binds_the_live_agent_at_read_time():
+    """Bound to the agent, so a rotation before the call is reflected, not stale."""
+    ctx = _context()
+    agent = _agent(model="first-model")
+    with hp.plugin_invocation_scope():
+        hp.set_plugin_invocation_agent(agent)
+        assert ctx.llm._bound_route.model == "first-model"
+        agent.model = "rotated-model"
+        assert ctx.llm._bound_route.model == "rotated-model"
+
+
+def test_ctx_llm_fails_closed_when_the_bound_agent_is_unusable():
+    ctx = _context()
+    with hp.plugin_invocation_scope():
+        hp.set_plugin_invocation_agent(SimpleNamespace())
+        llm = ctx.llm
+    assert llm.invocation_bound is True
+    with pytest.raises(PluginLlmInvocationError):
+        llm.complete(messages=[{"role": "user", "content": "hi"}])
+
+
+# ── Override rejection ────────────────────────────────────────────────────────
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"provider": "other"}, {"model": "other-model"}, {"agent_id": "other"},
+        {"profile": "other"}, {"task": "compression"},
+    ],
+)
+def test_a_bound_facade_refuses_every_override(kwargs):
+    """Refused, not ignored: silent acceptance would make the audit line lie."""
+    llm = PluginLlm(plugin_id="p").bind_invocation(_route())
+    with pytest.raises(PluginLlmTrustError):
+        llm.complete(messages=[{"role": "user", "content": "hi"}], **kwargs)
+
+
+def test_the_override_refusal_happens_before_any_request(monkeypatch):
+    client = _RecordingClient()
+    llm = PluginLlm(plugin_id="p").bind_invocation(_route(client=client))
+    with pytest.raises(PluginLlmTrustError):
+        llm.complete(messages=[{"role": "user", "content": "hi"}], model="other")
+    assert client.calls == []
+
+
+# ── The locked call ───────────────────────────────────────────────────────────
+
+def test_a_bound_call_uses_the_exact_client_once():
+    client = _RecordingClient()
+    llm = PluginLlm(plugin_id="p").bind_invocation(_route(client=client))
+    result = llm.complete(messages=[{"role": "user", "content": "hi"}])
+    assert len(client.calls) == 1, "a locked route must issue exactly one request"
+    assert client.calls[0]["model"] == "locked-model"
+    assert result.provider == "custom"
+    assert result.text == "ok"
+
+
+def test_a_bound_structured_call_reaches_the_same_client():
+    client = _RecordingClient()
+    llm = PluginLlm(plugin_id="p").bind_invocation(_route(client=client))
+    result = llm.complete_structured(
+        instructions="say ok", input=[PluginLlmTextInput(text="payload")])
+    assert len(client.calls) == 1
+    assert result.provider == "custom" and result.model == "locked-model"
+
+
+def test_a_transient_failure_is_not_retried_on_a_locked_route():
+    """call_llm would retry and then fall back; a locked route may do neither."""
+    client = _RecordingClient(raises=ConnectionError("boom"))
+    llm = PluginLlm(plugin_id="p").bind_invocation(_route(client=client))
+    with pytest.raises(PluginLlmInvocationError):
+        llm.complete(messages=[{"role": "user", "content": "hi"}])
+    assert len(client.calls) == 1, "the locked route retried or fell back"
+
+
+def test_a_provider_error_never_carries_its_message_into_the_code():
+    """The code is journaled; a provider message can hold a URL or key fragment."""
+    secret = "".join(["https://leak.example/v1?key=", "abcdef1234567890"])
+    client = _RecordingClient(raises=RuntimeError(secret))
+    llm = PluginLlm(plugin_id="p").bind_invocation(_route(client=client))
+    with pytest.raises(PluginLlmInvocationError) as excinfo:
+        llm.complete(messages=[{"role": "user", "content": "hi"}])
+    assert secret not in str(excinfo.value)
+    assert secret not in excinfo.value.code
+
+
+def test_an_unsupported_api_mode_fails_closed_rather_than_being_coerced():
+    client = _RecordingClient()
+    llm = PluginLlm(plugin_id="p").bind_invocation(
+        _route(client=client, api_mode="anthropic_messages"))
+    with pytest.raises(PluginLlmInvocationError) as excinfo:
+        llm.complete(messages=[{"role": "user", "content": "hi"}])
+    assert excinfo.value.code == "unsupported_api_mode"
+    assert client.calls == [], "an unsupported transport must not be attempted"
+
+
+def test_a_route_with_no_client_is_incomplete_not_rebuilt():
+    llm = PluginLlm(plugin_id="p")
+    route = PluginInvocationRoute(
+        provider="custom", model="m", base_url="https://x.example/v1",
+        api_key="k", api_mode="chat_completions", client=None)
+    with pytest.raises(PluginLlmInvocationError) as excinfo:
+        llm.bind_invocation(route).complete(messages=[{"role": "user", "content": "hi"}])
+    assert excinfo.value.code == "incomplete_route"
+
+
+def test_error_classification_is_coarse_and_stable():
+    assert classify_route_locked_error(ConnectionError("x")) == "transport_error"
+    assert classify_route_locked_error(RuntimeError("x")) == "call_failed"
+
+
+def test_route_locked_error_is_not_swallowed_by_the_generic_wrapper():
+    """A RouteLockedCallError must keep its own code, not become call_failed."""
+    from agent.auxiliary_client import call_llm_route_locked
+
+    with pytest.raises(RouteLockedCallError) as excinfo:
+        call_llm_route_locked(
+            provider="custom", model="m", base_url="https://x.example/v1", api_key="k",
+            api_mode="chat_completions", client=_RecordingClient(), messages=[])
+    assert excinfo.value.code == "empty_request"
+
+
+class _AsyncRecordingClient:
+    """Async sibling of _RecordingClient: the async path awaits ``create``."""
+
+    def __init__(self, *, raises: BaseException | None = None):
+        self.calls: list[dict] = []
+        self._raises = raises
+        outer = self
+
+        class _Completions:
+            async def create(self, **kwargs):
+                outer.calls.append(kwargs)
+                if outer._raises is not None:
+                    raise outer._raises
+                return _response()
+
+        self.chat = SimpleNamespace(completions=_Completions())
+        self.base_url = "https://locked.example/v1"
+
+
+def test_the_async_locked_path_holds_the_same_guarantees():
+    client = _AsyncRecordingClient()
+    llm = PluginLlm(plugin_id="p").bind_invocation(_route(client=client))
+
+    async def _go():
+        return await llm.acomplete(messages=[{"role": "user", "content": "hi"}])
+
+    result = asyncio.run(_go())
+    assert len(client.calls) == 1
+    assert result.model == "locked-model"
+
+
+def test_the_async_locked_path_does_not_retry_either():
+    client = _AsyncRecordingClient(raises=ConnectionError("boom"))
+    llm = PluginLlm(plugin_id="p").bind_invocation(_route(client=client))
+
+    async def _go():
+        return await llm.acomplete(messages=[{"role": "user", "content": "hi"}])
+
+    with pytest.raises(PluginLlmInvocationError):
+        asyncio.run(_go())
+    assert len(client.calls) == 1
+
+
+# ── Concurrency ───────────────────────────────────────────────────────────────
+
+def test_two_concurrent_scopes_do_not_see_each_others_route():
+    """The binding is task-local; a shared global would cross turns under load."""
+    seen: dict[str, str] = {}
+    started = threading.Barrier(2)
+
+    def _worker(name: str) -> None:
+        def _run() -> None:
+            with hp.plugin_invocation_scope(_route(model=f"{name}-model")):
+                started.wait(timeout=5)
+                binding = hp._plugin_invocation_binding.get()
+                seen[name] = binding.route.model
+
+        contextvars.copy_context().run(_run)
+
+    threads = [threading.Thread(target=_worker, args=(n,)) for n in ("a", "b")]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(timeout=10)
+    assert seen == {"a": "a-model", "b": "b-model"}
