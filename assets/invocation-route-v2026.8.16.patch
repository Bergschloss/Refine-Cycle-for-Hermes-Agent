+    fallback.assert_not_called()
+    factory.assert_not_called()
+
+
+def test_single_attempt_async_preserves_cap_and_never_retries():
+    client = MagicMock()
+    client.chat.completions.create.return_value = _response()
+
+    async def run():
+        with patch("agent.auxiliary_client._to_async_client") as rebuild:
+            response = await async_call_llm(
+                provider="custom",
+                model="locked-model",
+                base_url="https://locked.example/v1",
+                api_key="test-key",
+                api_mode="chat_completions",
+                bound_client=client,
+                messages=[{"role": "user", "content": "private evidence"}],
+                max_tokens=CAP_SENTINEL,
+                single_attempt=True,
+            )
+            rebuild.assert_not_called()
