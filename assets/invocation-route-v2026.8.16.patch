@@ -0,0 +1,471 @@
+"""Regression coverage for invocation-bound plugin LLM routing."""
+
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent.auxiliary_client import (
+    RouteLockedCallError,
+    async_call_llm,
+    call_llm,
+)
+from agent.plugin_llm import (
+    BoundPluginLlm,
+    PluginInvocationRoute,
+    PluginLlmInvocationError,
+    PluginLlmTrustError,
+    _TrustPolicy,
+    make_plugin_llm_for_test,
+)
+
+
+CAP_SENTINEL = 8173
+
+
+def _response(text: str = "ok") -> SimpleNamespace:
+    return SimpleNamespace(
+        choices=[SimpleNamespace(message=SimpleNamespace(content=text))],
+        usage=SimpleNamespace(prompt_tokens=1, completion_tokens=1, total_tokens=2),
+    )
+
+
+def _route(
+    *, model: str = "locked-model", client=None
+) -> PluginInvocationRoute:
+    return PluginInvocationRoute(
+        provider="custom",
+        model=model,
+        base_url="https://locked.example/v1",
+        api_key="test-key",
+        api_mode="chat_completions",
+        client=client,
+    )
+
+
+def _base(**kwargs):
+    return make_plugin_llm_for_test(
+        plugin_id="refine",
+        policy=_TrustPolicy(plugin_id="refine"),
+        **kwargs,
+    )
+
+
+def test_bound_facade_uses_captured_route_and_preserves_cap():
+    captured: dict = {}
+
+    def fake_caller(**kwargs):
+        captured.update(kwargs)
+        return kwargs["provider_override"], kwargs["model_override"], _response()
+
+    base = _base(sync_caller=fake_caller)
+    bound = base.bind_invocation(_route())
+    result = bound.complete(
+        [{"role": "user", "content": "private evidence"}],
+        max_tokens=CAP_SENTINEL,
+    )
+
+    assert isinstance(bound, BoundPluginLlm)
+    assert base.invocation_bound is False
+    assert bound.invocation_bound is True
+    assert (result.provider, result.model) == ("custom", "locked-model")
+    assert captured["bound_route"] == _route()
+    assert captured["single_attempt"] is True
+    assert captured["max_tokens"] == CAP_SENTINEL
+
+
+@pytest.mark.parametrize(
+    "override",
+    [
+        {"provider": "other"},
+        {"model": "other"},
+        {"agent_id": "other"},
+        {"profile": "other"},
+        {"task": "classifier"},
+    ],
+)
+def test_bound_facade_rejects_every_route_override_before_call(override):
+    caller = MagicMock()
+    bound = _base(sync_caller=caller).bind_invocation(_route())
+
+    with pytest.raises(PluginLlmTrustError, match="invocation-bound"):
+        bound.complete(
+            [{"role": "user", "content": "private evidence"}],
+            max_tokens=CAP_SENTINEL,
+            **override,
+        )
+
+    caller.assert_not_called()
+
+
+def test_plugin_scope_starts_fail_closed_then_accepts_settled_route_and_resets():
+    from hermes_cli.plugins import (
+        PluginContext,
+        PluginManifest,
+        PluginManager,
+        plugin_invocation_scope,
+        set_plugin_invocation_route,
+    )
+
+    context = PluginContext(
+        PluginManifest(name="refine", key="refine"), PluginManager()
+    )
+    base = context.llm
+    assert set_plugin_invocation_route(_route()) is False
+
+    with plugin_invocation_scope():
+        incomplete = context.llm
+        assert incomplete.invocation_bound is True
+        with pytest.raises(PluginLlmInvocationError) as raised:
+            incomplete.complete(
+                [{"role": "user", "content": "private evidence"}],
+                max_tokens=CAP_SENTINEL,
+            )
+        assert raised.value.code == "incomplete_route"
+
+        assert set_plugin_invocation_route(_route(model="settled")) is True
+        assert context.llm._bound_route.model == "settled"
+
+    assert context.llm is base
+    assert context.llm.invocation_bound is False
+
+
+def test_plugin_scopes_nest_and_restore_parent_route_after_child_error():
+    from hermes_cli.plugins import (
+        PluginContext,
+        PluginManifest,
+        PluginManager,
+        plugin_invocation_scope,
+    )
+
+    context = PluginContext(
+        PluginManifest(name="refine", key="refine"), PluginManager()
+    )
+    with plugin_invocation_scope(_route(model="parent")):
+        assert context.llm._bound_route.model == "parent"
+        with pytest.raises(RuntimeError, match="child failed"):
+            with plugin_invocation_scope(_route(model="child")):
+                assert context.llm._bound_route.model == "child"
+                raise RuntimeError("child failed")
+        assert context.llm._bound_route.model == "parent"
+    assert context.llm.invocation_bound is False
+
+
+def test_concurrent_async_scopes_cannot_observe_each_others_routes():
+    from hermes_cli.plugins import (
+        PluginContext,
+        PluginManifest,
+        PluginManager,
+        plugin_invocation_scope,
+    )
+
+    context = PluginContext(
+        PluginManifest(name="refine", key="refine"), PluginManager()
+    )
+
+    async def worker(model: str, ready: asyncio.Event, other: asyncio.Event):
+        with plugin_invocation_scope(_route(model=model)):
+            ready.set()
+            await other.wait()
+            await asyncio.sleep(0)
+            return context.llm._bound_route.model
+
+    async def run():
+        first = asyncio.Event()
+        second = asyncio.Event()
+        return await asyncio.gather(
+            worker("first", first, second),
+            worker("second", second, first),
+        )
+
+    assert asyncio.run(run()) == ["first", "second"]
+    assert context.llm.invocation_bound is False
+
+
+def test_single_attempt_sync_preserves_cap_and_never_retries_or_falls_back():
+    client = MagicMock()
+    client.chat.completions.create.return_value = _response()
+
+    with patch("agent.auxiliary_client.OpenAI") as factory, patch(
+        "agent.auxiliary_client._try_payment_fallback"
+    ) as fallback:
+        response = call_llm(
+            provider="custom",
+            model="locked-model",
+            base_url="https://locked.example/v1",
+            api_key="test-key",
+            api_mode="chat_completions",
+            bound_client=client,
+            messages=[{"role": "user", "content": "private evidence"}],
+            max_tokens=CAP_SENTINEL,
+            single_attempt=True,
+        )
+
+    assert response.choices[0].message.content == "ok"
+    assert client.chat.completions.create.call_count == 1
+    kwargs = client.chat.completions.create.call_args.kwargs
+    assert kwargs.get("max_tokens", kwargs.get("max_completion_tokens")) == CAP_SENTINEL
+    fallback.assert_not_called()
+    factory.assert_not_called()
+
+
+def test_single_attempt_sync_propagates_first_transport_error_without_fallback():
+    client = MagicMock()
+    client.chat.completions.create.side_effect = ConnectionError("network down")
+
+    with patch("agent.auxiliary_client.OpenAI") as factory, patch(
+        "agent.auxiliary_client._try_payment_fallback"
+    ) as fallback:
+        with pytest.raises(ConnectionError, match="network down"):
+            call_llm(
+                provider="custom",
+                model="locked-model",
+                base_url="https://locked.example/v1",
+                api_key="test-key",
+                api_mode="chat_completions",
+                bound_client=client,
+                messages=[{"role": "user", "content": "private evidence"}],
+                max_tokens=CAP_SENTINEL,
+                single_attempt=True,
+            )
