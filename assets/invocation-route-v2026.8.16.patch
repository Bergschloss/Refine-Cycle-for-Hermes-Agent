+    assert kwargs.get("max_tokens", kwargs.get("max_completion_tokens")) == CAP_SENTINEL
+
+
+def test_route_errors_are_stable_and_unsupported_modes_make_no_request():
+    client_factory = MagicMock()
+
+    with patch("agent.auxiliary_client.OpenAI", client_factory):
+        with pytest.raises(RouteLockedCallError) as raised:
+            call_llm(
+                provider="custom",
+                model="locked-model",
+                base_url="https://secret-endpoint.example/v1",
