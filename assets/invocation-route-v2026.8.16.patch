+def _call_route_locked_once(
+    *,
+    provider: str,
+    model: str,
+    base_url: str,
+    api_key: str,
+    api_mode: str,
+    messages: list,
+    temperature: Optional[float],
+    max_tokens: Optional[int],
+    tools: Optional[list],
+    timeout: Optional[float],
+    extra_body: Optional[dict],
+    async_mode: bool,
 ) -> Any:
+    """Make exactly one request on an already-resolved gateway route.
+
+    This path deliberately accepts no task/configuration input. It never
+    resolves a provider, refreshes credentials, rotates a pool, strips the
+    output cap, retries, or falls back. A route that cannot be represented
+    directly fails before any network request rather than silently changing
+    where a plugin's private prompt is sent.
+    """
+    if not provider or provider == "auto" or not model or not base_url or not api_mode:
+        raise RuntimeError("single-attempt plugin LLM call requires a complete explicit route")
+    supported_api_modes = {
+        "chat_completions",
+        "codex_responses",
+        "anthropic_messages",
+    }
+    if api_mode not in supported_api_modes:
+        raise RuntimeError(
+            "single-attempt plugin LLM calls do not support "
+            f"the {api_mode!r} API mode"
+        )
+
+    if api_mode == "anthropic_messages":
+        from agent.anthropic_adapter import build_anthropic_client
+
+        raw_client = build_anthropic_client(api_key, base_url)
+        client: Any = AnthropicAuxiliaryClient(
+            raw_client, model, api_key, base_url, is_oauth=api_key.startswith("sk-ant-oat")
+        )
+    else:
+        clean_base, default_query = _extract_url_query_params(
+            _to_openai_base_url(base_url)
+        )
+        client_kwargs: Dict[str, Any] = {}
+        if default_query:
+            client_kwargs["default_query"] = default_query
+        if api_mode == "codex_responses":
+            client_kwargs["default_headers"] = _codex_cloudflare_headers(api_key)
+        client = OpenAI(api_key=api_key or "no-key-required", base_url=clean_base, **client_kwargs)
+        if api_mode == "codex_responses":
+            client = CodexAuxiliaryClient(client, model)
+
+    if async_mode:
+        client, final_model = _to_async_client(client, model)
+    else:
+        final_model = model
+
+    kwargs = _build_call_kwargs(
+        provider,
+        final_model,
+        messages,
+        temperature=temperature,
+        max_tokens=max_tokens,
+        tools=tools,
+        timeout=timeout if timeout is not None else _DEFAULT_AUX_TIMEOUT,
+        extra_body=extra_body,
+        base_url=base_url,
+        require_max_tokens=True,
+    )
+    if _is_anthropic_compat_endpoint(provider, base_url):
+        kwargs["messages"] = _convert_openai_images_to_anthropic(kwargs["messages"])
+    if async_mode:
+        async def _call() -> Any:
+            return _validate_llm_response(
+                await client.chat.completions.create(**kwargs), "plugin_invocation"
+            )
+        return _call()
+    return _validate_llm_response(
+        client.chat.completions.create(**kwargs), "plugin_invocation"
+    )
+
