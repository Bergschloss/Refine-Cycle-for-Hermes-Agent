+    if _plugin_invocation_binding.get() is None:
+        return False
+    _plugin_invocation_binding.set(_PluginInvocationBinding(agent=agent, error_code=None))
+    return True
+
+
+@contextmanager
+def plugin_invocation_scope_for_agent(agent: Any) -> Iterator[None]:
+    """Bind a direct command to its live agent, or expose a stable failure."""
+    route = None
