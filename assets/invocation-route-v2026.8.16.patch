+        from agent.plugin_llm import PluginInvocationRoute
+        route = PluginInvocationRoute.from_agent(agent)
+    except Exception:
+        logger.debug("Plugin invocation route unavailable", exc_info=True)
+    with plugin_invocation_scope(route):
+        yield
+
