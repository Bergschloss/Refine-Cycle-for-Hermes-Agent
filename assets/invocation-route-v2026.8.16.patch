+@dataclass(frozen=True)
+class PluginInvocationRoute:
+    """The immutable, already-resolved route for one host invocation.
+
+    The route is created by the gateway from a live ``AIAgent`` or its
+    authoritative session runtime. It is intentionally not reconstructed from
+    global configuration: concurrent sessions may have different endpoints and
+    credentials even while they share a process.
+    """
+
+    provider: str
+    model: str
+    base_url: str
+    api_key: str
+    api_mode: str
+
+    @classmethod
+    def from_agent(cls, agent: Any) -> "PluginInvocationRoute":
+        return cls(
+            provider=str(getattr(agent, "provider", "") or "").strip(),
+            model=str(getattr(agent, "model", "") or "").strip(),
+            base_url=str(getattr(agent, "base_url", "") or "").strip(),
+            api_key=str(getattr(agent, "api_key", "") or "").strip(),
+            api_mode=str(getattr(agent, "api_mode", "") or "").strip(),
+        ).validated()
+
+    @classmethod
+    def from_runtime(cls, model: str, runtime: Dict[str, Any]) -> "PluginInvocationRoute":
+        return cls(
+            provider=str(runtime.get("provider", "") or "").strip(),
+            model=str(model or "").strip(),
+            base_url=str(runtime.get("base_url", "") or "").strip(),
+            api_key=str(runtime.get("api_key", "") or "").strip(),
+            api_mode=str(runtime.get("api_mode", "") or "").strip(),
+        ).validated()
+
+    def validated(self) -> "PluginInvocationRoute":
+        if not self.provider or self.provider == "auto":
+            raise RuntimeError("plugin invocation route requires an explicit provider")
+        if not self.model:
+            raise RuntimeError("plugin invocation route requires an explicit model")
+        if not self.base_url:
+            raise RuntimeError("plugin invocation route requires an explicit base URL")
+        if not self.api_mode:
+            raise RuntimeError("plugin invocation route requires an explicit API mode")
+        return self
+
+
