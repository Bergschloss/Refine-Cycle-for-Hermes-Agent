+@dataclass(frozen=True)
+class _PluginInvocationBinding:
+    """Task-local route state for one active host invocation."""
+
+    route: Any = None
+    agent: Any = None
+    error_code: Optional[str] = "incomplete_route"
+
+
+_plugin_invocation_binding: ContextVar[Optional[_PluginInvocationBinding]] = ContextVar(
+    "plugin_invocation_binding", default=None
+)
+
+
+@contextmanager
+def plugin_invocation_scope(route: Any = None) -> Iterator[None]:
+    """Open a reset-safe invocation scope, failing closed until route assignment."""
+    binding = _PluginInvocationBinding(
+        route=route,
+        error_code=None if route is not None else "incomplete_route",
