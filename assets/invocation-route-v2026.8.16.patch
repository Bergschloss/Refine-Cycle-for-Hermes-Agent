@@ -0,0 +1,199 @@
+"""Regression coverage for gateway-bound plugin LLM invocations."""
+
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+from agent.auxiliary_client import async_call_llm, call_llm
+from agent.plugin_llm import (
+    BoundPluginLlm,
+    PluginInvocationRoute,
+    PluginLlmTrustError,
+    _TrustPolicy,
+    make_plugin_llm_for_test,
+)
+
+
+CAP_SENTINEL = 8173
+
+
+def _response(text: str = "ok") -> SimpleNamespace:
+    return SimpleNamespace(
+        choices=[SimpleNamespace(message=SimpleNamespace(content=text))],
+        usage=SimpleNamespace(prompt_tokens=1, completion_tokens=1, total_tokens=2),
+    )
+
+
+def _route(*, provider: str = "custom", model: str = "locked-model") -> PluginInvocationRoute:
+    return PluginInvocationRoute(
+        provider=provider,
+        model=model,
+        base_url="https://locked.example/v1",
+        api_key="test-key",
+        api_mode="chat_completions",
+    )
+
+
+def test_bound_facade_uses_captured_route_and_rejects_overrides():
+    captured: dict = {}
+
+    def fake_caller(**kwargs):
+        captured.update(kwargs)
+        return kwargs["provider_override"], kwargs["model_override"], _response()
+
+    base = make_plugin_llm_for_test(
+        plugin_id="refine",
+        policy=_TrustPolicy(plugin_id="refine"),
+        sync_caller=fake_caller,
+    )
+    bound = base.bind_invocation(_route())
+
+    result = bound.complete([{"role": "user", "content": "private evidence"}], max_tokens=CAP_SENTINEL)
+
+    assert isinstance(bound, BoundPluginLlm)
+    assert result.provider == "custom"
+    assert result.model == "locked-model"
+    assert captured["bound_route"] == _route()
+    assert captured["single_attempt"] is True
+    assert captured["max_tokens"] == CAP_SENTINEL
+    with pytest.raises(PluginLlmTrustError, match="invocation-bound"):
+        bound.complete([{"role": "user", "content": "x"}], model="other-model")
+
+
+def test_plugin_context_scopes_are_nested_and_do_not_mutate_the_base_facade():
+    from hermes_cli.plugins import (
+        PluginContext,
+        PluginManifest,
+        PluginManager,
+        plugin_invocation_scope,
+    )
+
+    ctx = PluginContext(PluginManifest(name="refine", key="refine"), PluginManager())
+    base = ctx.llm
+    first_route = _route(model="first-model")
+    second_route = _route(model="second-model")
+
+    with plugin_invocation_scope(first_route):
+        first = ctx.llm
+        with plugin_invocation_scope(second_route):
+            second = ctx.llm
+            assert second._bound_route == second_route
+        assert first._bound_route == first_route
+    assert ctx.llm is base
+
+
+def test_single_attempt_sync_preserves_cap_and_never_retries():
+    client = MagicMock()
+    client.chat.completions.create.return_value = _response()
+
+    with patch("agent.auxiliary_client.OpenAI", return_value=client):
+        response = call_llm(
+            provider="custom",
+            model="locked-model",
+            base_url="https://locked.example/v1",
+            api_key="test-key",
+            api_mode="chat_completions",
+            messages=[{"role": "user", "content": "private evidence"}],
+            max_tokens=CAP_SENTINEL,
+            single_attempt=True,
+        )
+
+    assert response.choices[0].message.content == "ok"
+    assert client.chat.completions.create.call_count == 1
+    assert client.chat.completions.create.call_args.kwargs["max_tokens"] == CAP_SENTINEL
+
+
+def test_single_attempt_sync_propagates_first_error_without_fallback():
+    client = MagicMock()
+    client.chat.completions.create.side_effect = ConnectionError("network down")
+
+    with patch("agent.auxiliary_client.OpenAI", return_value=client), patch(
+        "agent.auxiliary_client._try_payment_fallback"
+    ) as fallback:
+        with pytest.raises(ConnectionError, match="network down"):
+            call_llm(
+                provider="custom",
+                model="locked-model",
+                base_url="https://locked.example/v1",
+                api_key="test-key",
+                api_mode="chat_completions",
+                messages=[{"role": "user", "content": "private evidence"}],
+                max_tokens=CAP_SENTINEL,
+                single_attempt=True,
+            )
+
+    assert client.chat.completions.create.call_count == 1
+    fallback.assert_not_called()
+
+
+def test_single_attempt_async_preserves_cap_and_never_retries():
+    client = MagicMock()
+    client.chat.completions.create = AsyncMock(return_value=_response())
+
+    async def run() -> object:
+        with patch("agent.auxiliary_client.OpenAI", return_value=client), patch(
+            "agent.auxiliary_client._to_async_client",
+            return_value=(client, "locked-model"),
+        ):
+            return await async_call_llm(
+                provider="custom",
+                model="locked-model",
+                base_url="https://locked.example/v1",
+                api_key="test-key",
+                api_mode="chat_completions",
+                messages=[{"role": "user", "content": "private evidence"}],
+                max_tokens=CAP_SENTINEL,
+                single_attempt=True,
+            )
+
+    response = asyncio.run(run())
+    assert response.choices[0].message.content == "ok"
+    assert client.chat.completions.create.await_count == 1
+    assert client.chat.completions.create.call_args.kwargs["max_tokens"] == CAP_SENTINEL
+
+
+def test_plugin_route_scope_propagates_to_concurrent_tool_workers():
+    """Concurrent plugin tools retain the invocation route captured by the gateway."""
+    from concurrent.futures import ThreadPoolExecutor
+
+    from hermes_cli.plugins import (
+        PluginContext,
+        PluginManifest,
+        PluginManager,
+        plugin_invocation_scope,
+    )
+    from tools.thread_context import propagate_context_to_thread
+
+    route = _route(model="worker-locked-model")
+    context = PluginContext(PluginManifest(name="refine", key="refine"), PluginManager())
+    base = context.llm
+
+    with plugin_invocation_scope(route), ThreadPoolExecutor(max_workers=1) as executor:
+        bound = executor.submit(propagate_context_to_thread(lambda: context.llm)).result()
+
+    assert isinstance(bound, BoundPluginLlm)
+    assert bound._bound_route == route
+    assert context.llm is base
+
+
+def test_single_attempt_rejects_unrepresentable_transport_before_a_request():
+    client_factory = MagicMock()
+
+    with patch("agent.auxiliary_client.OpenAI", client_factory):
+        with pytest.raises(RuntimeError, match="codex_app_server"):
+            call_llm(
+                provider="custom",
+                model="locked-model",
+                base_url="https://locked.example/v1",
+                api_key="test-key",
+                api_mode="codex_app_server",
+                messages=[{"role": "user", "content": "private evidence"}],
+                max_tokens=CAP_SENTINEL,
+                single_attempt=True,
+            )
+
+    client_factory.assert_not_called()
